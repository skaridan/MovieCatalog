@model MovieDeleteViewModel

@{
	ViewData["Title"] = "Delete Movie";
}

<style>
	.delete-container {
		max-width: 500px;
		margin: 50px auto;
		padding: 20px;
	}

	.delete-card {
		background: white;
		border-radius: 15px;
		padding: 40px;
		box-shadow: 0 4px 15px rgba(0,0,0,0.1);
		text-align: center;
		border: 1px solid #ff6b6b;
	}

	.warning-icon {
		font-size: 4em;
		margin-bottom: 20px;
	}

	h2 {
		color: #1a1a2e;
		margin-bottom: 20px;
		font-size: 2em;
	}

	.movie-title {
		color: #dc3545;
		font-weight: 700;
		font-size: 1.8em;
		margin: 20px 0;
		padding: 15px;
		background: #f8f9fa;
		border-radius: 8px;
		border-left: 4px solid #dc3545;
	}

	.warning-text {
		color: #666;
		margin-bottom: 30px;
		font-size: 1.1em;
	}

		.warning-text small {
			color: #999;
			font-size: 0.9em;
		}

	.action-buttons {
		display: flex;
		gap: 15px;
		justify-content: center;
		margin-top: 30px;
	}

	.btn-delete {
		background: #dc3545;
		color: white;
		padding: 12px 30px;
		border: none;
		border-radius: 8px;
		font-size: 1.1em;
		cursor: pointer;
		transition: all 0.3s ease;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

		.btn-delete:hover {
			background: #c82333;
			transform: translateY(-2px);
			box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
		}

	.btn-cancel {
		background: #6c757d;
		color: white;
		padding: 12px 30px;
		border: none;
		border-radius: 8px;
		font-size: 1.1em;
		cursor: pointer;
		transition: all 0.3s ease;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

		.btn-cancel:hover {
			background: #5a6268;
			transform: translateY(-2px);
			box-shadow: 0 5px 15px rgba(108, 117, 125, 0.4);
		}

	hr {
		background: linear-gradient(90deg, transparent, #dc3545, #ff6b6b, transparent);
		height: 2px;
		border: none;
		margin: 20px 0;
	}
</style>

<div class="delete-container">
	<div class="delete-card">
		<div class="warning-icon">⚠️</div>

		<h2>Delete Movie</h2>

		<hr />

		<p class="warning-text">
			Are you sure you want to delete <strong>@Model.Title</strong>?
		</p>

		<div class="movie-title">
			"@Model.Title"
		</div>

		<p class="warning-text">
			<small>This action cannot be undone.</small>
		</p>

		<div class="action-buttons">
			<form asp-action="Delete" method="post">
				@Html.AntiForgeryToken()
				<input type="hidden" name="id" value="@Model.Id" />
				<button type="submit" class="btn-delete">
					🗑️ Yes, Delete
				</button>
			</form>

			<a asp-action="All" class="btn-cancel">
				⬅️ Cancel
			</a>
		</div>
	</div>
</div>

<style>
	footer {
		background: linear-gradient(45deg, #1a1a2e, #16213e);
		color: white !important;
		padding: 20px;
		border-radius: 10px 10px 0 0;
		margin-top: 30px;
	}

		footer a {
			color: #667eea !important;
			transition: color 0.3s ease;
		}

			footer a:hover {
				color: #764ba2 !important;
				text-decoration: none;
			}
</style>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}